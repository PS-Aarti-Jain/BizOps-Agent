# ==============================================================================
# BizOps Agent — AI-Powered Business Operations Assistant Configuration
# ==============================================================================

# LLM Provider Configuration (Primary: Groq API)
LLM_PROVIDER=groq

# Official Groq API Configuration
# Get your free API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=20.0
GROQ_MAX_RETRIES=1

# Time Budget Controls
QUERY_TIMEOUT_SECONDS=60.0
MAX_REACT_ITERATIONS=6
OBSERVATION_CHAR_LIMIT=1500
TOOL_EXECUTION_TIMEOUT_SECONDS=10.0
PA_EXPIRATION_SECONDS=600
PRICE_CHANGE_TOLERANCE_PCT=0.05

# Google Sheets Integration Configuration
# Set the path to your service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=
# Google Sheets Spreadsheet ID (found in sheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_DEFAULT_WORKSHEET=Inventory

# Environment & Server
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8080
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Feature Toggles
DEMO_MODE=true
DEVELOPER_MODE=false
MULTI_AGENT=false
